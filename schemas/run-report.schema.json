{
  "$defs": {
    "Applicability": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "can_compute": {
          "title": "Can Compute",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Reasons",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ApplicabilityStatus"
        }
      },
      "required": [
        "status",
        "can_compute",
        "reasons"
      ],
      "title": "Applicability",
      "type": "object"
    },
    "ApplicabilityStatus": {
      "enum": [
        "APPLICABLE",
        "CONDITIONALLY_APPLICABLE",
        "NOT_APPLICABLE",
        "INSUFFICIENT_METADATA",
        "UNSUPPORTED"
      ],
      "title": "ApplicabilityStatus",
      "type": "string"
    },
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "derived_from": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        },
        "path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Path",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Id",
          "type": "string"
        },
        "transformation": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Transformation",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "source_id",
        "role",
        "transformation"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "ClockDefinition": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "assay": {
          "$ref": "#/$defs/Requirement"
        },
        "clinical_validity": {
          "const": "NOT_ESTABLISHED",
          "title": "Clinical Validity",
          "type": "string"
        },
        "clock_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Clock Id",
          "type": "string"
        },
        "coefficient_column": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Coefficient Column",
          "type": "string"
        },
        "coefficients": {
          "$ref": "#/$defs/Artifact"
        },
        "external_validation": {
          "const": "NOT_ASSESSED",
          "title": "External Validation",
          "type": "string"
        },
        "feature_column": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Feature Column",
          "type": "string"
        },
        "feature_contract": {
          "$ref": "#/$defs/FeatureContract"
        },
        "fixture_manifest": {
          "$ref": "#/$defs/Artifact"
        },
        "genome_build_note": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Genome Build Note",
          "type": "string"
        },
        "genome_build_required": {
          "title": "Genome Build Required",
          "type": "boolean"
        },
        "implementation_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Implementation Ids",
          "type": "array"
        },
        "intercept": {
          "title": "Intercept",
          "type": "number"
        },
        "intercept_label": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Intercept Label",
          "type": "string"
        },
        "missing_data": {
          "$ref": "#/$defs/MissingDataPolicy"
        },
        "modality": {
          "$ref": "#/$defs/Requirement"
        },
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "notes": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "platform": {
          "$ref": "#/$defs/Requirement"
        },
        "preprocessing": {
          "$ref": "#/$defs/PreprocessingRequirement"
        },
        "publication_source_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Publication Source Id",
          "type": "string"
        },
        "publication_year": {
          "title": "Publication Year",
          "type": "integer"
        },
        "research_use_only": {
          "const": true,
          "title": "Research Use Only",
          "type": "boolean"
        },
        "result_unit": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Result Unit",
          "type": "string"
        },
        "sample_type": {
          "$ref": "#/$defs/Requirement"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_source_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Scientific Source Ids",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "species": {
          "$ref": "#/$defs/Requirement"
        },
        "target": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Target",
          "type": "string"
        },
        "tissue": {
          "$ref": "#/$defs/Requirement"
        },
        "transform": {
          "$ref": "#/$defs/Transform"
        },
        "version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "clock_id",
        "name",
        "aliases",
        "version",
        "publication_year",
        "publication_source_id",
        "modality",
        "species",
        "tissue",
        "sample_type",
        "assay",
        "platform",
        "target",
        "result_unit",
        "feature_contract",
        "coefficients",
        "intercept",
        "coefficient_column",
        "feature_column",
        "intercept_label",
        "transform",
        "preprocessing",
        "missing_data",
        "genome_build_required",
        "genome_build_note",
        "sources",
        "implementation_ids",
        "fixture_manifest",
        "scientific_source_ids",
        "external_validation",
        "clinical_validity",
        "research_use_only",
        "notes"
      ],
      "title": "ClockDefinition",
      "type": "object"
    },
    "ComparisonCase": {
      "additionalProperties": false,
      "properties": {
        "absolute_difference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Absolute Difference"
        },
        "expected": {
          "$ref": "#/$defs/ScoreResult"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "relative_difference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Relative Difference"
        },
        "results": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/ScoreResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Results",
          "type": "object"
        },
        "sample_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Sample Id",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "expected",
        "results",
        "absolute_difference",
        "relative_difference",
        "passed"
      ],
      "title": "ComparisonCase",
      "type": "object"
    },
    "ComparisonReport": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "items": {
            "$ref": "#/$defs/ComparisonCase"
          },
          "title": "Cases",
          "type": "array"
        },
        "clock_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Clock Id",
          "type": "string"
        },
        "fixture_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Fixture Id",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "profile": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Profile",
          "type": "string"
        },
        "runs": {
          "items": {
            "$ref": "#/$defs/ConformanceReport"
          },
          "title": "Runs",
          "type": "array"
        },
        "tolerance": {
          "$ref": "#/$defs/Tolerance"
        }
      },
      "required": [
        "clock_id",
        "fixture_id",
        "profile",
        "passed",
        "tolerance",
        "runs",
        "cases"
      ],
      "title": "ComparisonReport",
      "type": "object"
    },
    "ConformanceCase": {
      "additionalProperties": false,
      "properties": {
        "absolute_difference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Absolute Difference"
        },
        "expected": {
          "$ref": "#/$defs/ScoreResult"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "linear_score_difference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Linear Score Difference"
        },
        "observed": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoreResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "publisher_rounded_match": {
          "title": "Publisher Rounded Match",
          "type": "boolean"
        },
        "relative_difference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Relative Difference"
        },
        "sample_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Sample Id",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "passed",
        "expected",
        "observed",
        "linear_score_difference",
        "absolute_difference",
        "relative_difference",
        "publisher_rounded_match"
      ],
      "title": "ConformanceCase",
      "type": "object"
    },
    "ConformanceReport": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "items": {
            "$ref": "#/$defs/ConformanceCase"
          },
          "title": "Cases",
          "type": "array"
        },
        "clock_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Clock Id",
          "type": "string"
        },
        "failed": {
          "title": "Failed",
          "type": "integer"
        },
        "fixture_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Fixture Id",
          "type": "string"
        },
        "fixture_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Fixture Version",
          "type": "string"
        },
        "implementation": {
          "$ref": "#/$defs/ImplementationMetadata"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "profile": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Profile",
          "type": "string"
        },
        "reference_implementation": {
          "$ref": "#/$defs/ImplementationMetadata"
        },
        "status": {
          "enum": [
            "REFERENCE_CONFORMANT",
            "NONCONFORMANT"
          ],
          "title": "Status",
          "type": "string"
        },
        "tolerance": {
          "$ref": "#/$defs/Tolerance"
        }
      },
      "required": [
        "clock_id",
        "fixture_id",
        "fixture_version",
        "profile",
        "status",
        "implementation",
        "reference_implementation",
        "passed",
        "failed",
        "tolerance",
        "cases"
      ],
      "title": "ConformanceReport",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "coverage_percentage": {
          "title": "Coverage Percentage",
          "type": "number"
        },
        "extra_count": {
          "title": "Extra Count",
          "type": "integer"
        },
        "extra_features": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Extra Features",
          "type": "array"
        },
        "invalid_count": {
          "title": "Invalid Count",
          "type": "integer"
        },
        "invalid_features": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Invalid Features",
          "type": "array"
        },
        "missing_count": {
          "title": "Missing Count",
          "type": "integer"
        },
        "missing_features": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Missing Features",
          "type": "array"
        },
        "present_count": {
          "title": "Present Count",
          "type": "integer"
        },
        "required_count": {
          "title": "Required Count",
          "type": "integer"
        },
        "usable_coverage_percentage": {
          "title": "Usable Coverage Percentage",
          "type": "number"
        },
        "valid_numeric_count": {
          "title": "Valid Numeric Count",
          "type": "integer"
        }
      },
      "required": [
        "required_count",
        "present_count",
        "valid_numeric_count",
        "missing_count",
        "invalid_count",
        "extra_count",
        "coverage_percentage",
        "usable_coverage_percentage",
        "missing_features",
        "invalid_features",
        "extra_features"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Dimensions": {
      "additionalProperties": false,
      "properties": {
        "assay_platform_compatibility": {
          "enum": [
            "DECLARED_COMPATIBLE",
            "UNKNOWN",
            "INCOMPATIBLE",
            "UNSUPPORTED"
          ],
          "title": "Assay Platform Compatibility",
          "type": "string"
        },
        "clinical_validity": {
          "const": "NOT_ESTABLISHED",
          "default": "NOT_ESTABLISHED",
          "title": "Clinical Validity",
          "type": "string"
        },
        "computational_applicability": {
          "$ref": "#/$defs/ApplicabilityStatus"
        },
        "external_validation": {
          "const": "NOT_ASSESSED",
          "default": "NOT_ASSESSED",
          "title": "External Validation",
          "type": "string"
        },
        "feature_coverage": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE"
          ],
          "title": "Feature Coverage",
          "type": "string"
        },
        "input_data_quality": {
          "enum": [
            "PASS",
            "FAIL"
          ],
          "title": "Input Data Quality",
          "type": "string"
        },
        "preprocessing_compatibility": {
          "enum": [
            "DECLARED_COMPATIBLE",
            "UNKNOWN",
            "INCOMPATIBLE",
            "UNSUPPORTED"
          ],
          "title": "Preprocessing Compatibility",
          "type": "string"
        },
        "reference_conformance": {
          "enum": [
            "NOT_RUN",
            "REFERENCE_CONFORMANT",
            "NONCONFORMANT"
          ],
          "title": "Reference Conformance",
          "type": "string"
        },
        "schema_validity": {
          "enum": [
            "VALID",
            "INVALID"
          ],
          "title": "Schema Validity",
          "type": "string"
        },
        "tissue_compatibility": {
          "enum": [
            "DECLARED_COMPATIBLE",
            "UNKNOWN",
            "INCOMPATIBLE",
            "UNSUPPORTED"
          ],
          "title": "Tissue Compatibility",
          "type": "string"
        }
      },
      "required": [
        "schema_validity",
        "input_data_quality",
        "feature_coverage",
        "preprocessing_compatibility",
        "assay_platform_compatibility",
        "tissue_compatibility",
        "computational_applicability",
        "reference_conformance"
      ],
      "title": "Dimensions",
      "type": "object"
    },
    "FeatureContract": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "identifier_pattern": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Identifier Pattern",
          "type": "string"
        },
        "identifier_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Identifier Type",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Minimum"
        },
        "source_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "unit": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "identifier_type",
        "identifier_pattern",
        "count",
        "unit",
        "minimum",
        "maximum",
        "source_ids"
      ],
      "title": "FeatureContract",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "schema",
            "data_quality",
            "coverage",
            "metadata",
            "implementation"
          ],
          "title": "Category",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "pattern": "^ACC_[A-Z_]+$",
          "title": "Code",
          "type": "string"
        },
        "feature_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Id"
        },
        "message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "row": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "code",
        "severity",
        "category",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "ImplementationMetadata": {
      "additionalProperties": false,
      "properties": {
        "algorithm_revision": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Algorithm Revision",
          "type": "string"
        },
        "clock_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Clock Id",
          "type": "string"
        },
        "deterministic": {
          "const": true,
          "title": "Deterministic",
          "type": "boolean"
        },
        "execution_mode": {
          "enum": [
            "executed",
            "recorded"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "implementation_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Implementation Id",
          "type": "string"
        },
        "language": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Language",
          "type": "string"
        },
        "runtime": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Runtime",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "stage": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Stage",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "implementation_id",
        "clock_id",
        "version",
        "language",
        "source",
        "source_sha256",
        "algorithm_revision",
        "stage",
        "deterministic",
        "execution_mode",
        "runtime"
      ],
      "title": "ImplementationMetadata",
      "type": "object"
    },
    "MissingDataPolicy": {
      "additionalProperties": false,
      "properties": {
        "note": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Note",
          "type": "string"
        },
        "policy": {
          "enum": [
            "complete_required",
            "unsupported"
          ],
          "title": "Policy",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "policy",
        "source_ids",
        "note"
      ],
      "title": "MissingDataPolicy",
      "type": "object"
    },
    "PreprocessingRequirement": {
      "additionalProperties": false,
      "properties": {
        "evidence_required": {
          "const": true,
          "title": "Evidence Required",
          "type": "boolean"
        },
        "normalization": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Normalization",
          "type": "string"
        },
        "note": {
          "minLength": 1,
          "pattern": "\\S",
