{
  "$defs": {
    "Assay": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "platform": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform"
        }
      },
      "title": "Assay",
      "type": "object"
    },
    "Preprocessing": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "normalization": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalization"
        },
        "reference_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Sha256"
        },
        "stage": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        }
      },
      "title": "Preprocessing",
      "type": "object"
    }
  },
  "$id": "https://github.com/jdj333/aging-clock-conformance/schemas/sample-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assay": {
      "$ref": "#/$defs/Assay"
    },
    "genome_build": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Genome Build"
    },
    "input_format": {
      "default": "long",
      "enum": [
        "long",
        "matrix"
      ],
      "title": "Input Format",
      "type": "string"
    },
    "measurements": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measurements"
    },
    "measurements_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measurements Sha256"
    },
    "modality": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Modality"
    },
    "preprocessing": {
      "$ref": "#/$defs/Preprocessing"
    },
    "sample_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Sample Id",
      "type": "string"
    },
    "sample_type": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sample Type"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "species": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Species"
    },
    "tissue": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tissue"
    },
    "unit": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    }
  },
  "required": [
    "sample_id"
  ],
  "title": "SampleManifest",
  "type": "object"
}
