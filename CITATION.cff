    title: DNA methylation age of human tissues and cell types
    authors:
      - family-names: Horvath
        given-names: Steve
    journal: Genome Biology
    year: 2013
    volume: 14
    doi: 10.1186/gb-2013-14-10-r115
  - type: article
    title: 'Erratum to: DNA methylation age of human tissues and cell types'
    authors:
      - family-names: Horvath
        given-names: Steve
    journal: Genome Biology
    year: 2015
    doi: 10.1186/s13059-015-0649-6
